# Server Port
PORT=5000

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=project_pkm

# Security (Ganti dengan string rahasia minimal 32 karakter di produksi)
JWT_SECRET=super_secret_jwt_key_minimal_32_characters_here

# Frontend / Client URL for CORS Whitelist (Pisahkan dengan koma jika lebih dari satu)
# Contoh produksi: https://tracerstudy-smkpuspitabangsa.vercel.app
CLIENT_URL=http://localhost:5173

# Machine Learning Flask API URL
# Contoh produksi: https://ml-api.yourdomain.com atau http://localhost:5001
ML_API_URL=http://localhost:5001

